<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Base Footprint & Base Link -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0725" rpy="0 0 0"/> <!-- Half of 14.5cm height -->
      <geometry>
        <cylinder radius="0.09" length="0.145"/> <!-- Diameter 18cm -> radius 9cm -->
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 7.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.145"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/> <!-- 1.5cm ground clearance -->
  </joint>

  <!-- Left Wheel -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.015"/> <!-- 3.5cm radius, 1.5cm width -->
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.085 0.02" rpy="-1.5707 0 0"/> <!-- Track width 17cm -> 8.5cm offset -->
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.015"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.085 0.02" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <!-- BNO085 IMU Link (Y forward, X right -> Adjusted rotation to align with ROS X-forward) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- 16.5cm height from ground, minus ground clearance/base_link origin -->
    <origin xyz="0 0 0.165" rpy="0 0 -1.5707"/> 
  </joint>

  <!-- Camera Link (14.5cm height, facing front, centered) -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.09 0 0.145" rpy="0 0 0"/> <!-- Mounted at the front edge (9cm radius) -->
  </joint>

  <!-- TFmini Plus LiDAR on Stepper Motor -->
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.05 0 0.165" rpy="0 0 0"/> <!-- 20mm above top plate / adjusted placement -->
  </joint>

</robot>
